{
	"schemaVersion": 1,
	"id": "bettered_enchanting",
	"version": "${version}",
	"name": "Bettered Enchanting",
	"description": "A complete overhaul of the enchanting system of Minecraft to make it rely less on randomness and tie it to exploration and game progression.",
	"authors": [ "_TheCuteFox_", "TheEnderCore" ],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/TheEnderCore/bettered_enchanting"
	},
	"license": "CC0-1.0",
	"icon": "assets/bettered_enchanting/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"cutefox.bettered_enchanting.BetteredEnchanting"
		],
		"client": [
			"cutefox.bettered_enchanting.client.BetteredEnchantingClient"
		],
		"fabric-datagen": [
			"cutefox.bettered_enchanting.data.gen.ModDataGenerator"
		],
		"modmenu": [
			"cutefox.bettered_enchanting.client.config.ModMenuIntegration"
		]
	},
	"mixins": [
		"bettered_enchanting.mixins.json"
	],
	"accessWidener" : "bettered_enchanting.accesswidener",
	"depends": {
		"fabricloader": ">=0.15.11",
		"minecraft": "~1.21",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"incantationem": "*"
	}
}